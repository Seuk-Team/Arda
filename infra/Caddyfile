api.seuk.suvisdev.cloud {
	handle_path /demo/* {
		root * /srv/demo
		file_server
	}

	# 거짓말 탐지 (ai/lie-detection). handle_path 라 앞의 /ai 는 떼고 넘어간다 —
	# /ai/analyze 로 들어오면 서비스는 /analyze 로 받는다.
	handle_path /ai/* {
		# 본문 한도를 여기 안에서만 올린다. 사이트 전체에 걸면 이력서 업로드(F1)의
		# 방어까지 같이 느슨해진다.
		request_body {
			max_size 200MB
		}
		# 영상 분석이 분 단위까지 가므로 기본 타임아웃으로는 정상 처리 중인 요청이 끊긴다.
		reverse_proxy lie-detection:5000 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# n8n 편집 화면·웹훅 (ADR-0030). handle 이지 handle_path 가 아니다 — n8n 은 N8N_PATH=/n8n/ 로
	# 자기 경로를 알고 있어 앞을 떼면 안 된다. Basic Auth 는 팀 전원 공유 계정 하나 —
	# 사용자·해시는 compose 가 .env 에서 환경변수로 넣는다(여기 평문 없음).
	# 해시 만들기: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<비밀번호>'
	handle /n8n/* {
		basic_auth {
			{env.N8N_BASIC_AUTH_USER} {env.N8N_BASIC_AUTH_HASH}
		}
		reverse_proxy n8n:5678
	}

	reverse_proxy api:8000
}
