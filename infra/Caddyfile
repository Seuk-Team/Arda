api.seuk.suvisdev.cloud {
	handle_path /demo/* {
		root * /srv/demo
		file_server
	}

	# 거짓말 탐지 (ai/lie-detection). handle_path 라 앞의 /ai 는 떼고 넘어간다 —
	# /ai/analyze 로 들어오면 서비스는 /analyze 로 받는다.
	handle_path /ai/* {
		# 본문 한도를 여기 안에서만 올린다. 사이트 전체에 걸면 이력서 업로드(F1)의
		# 방어까지 같이 느슨해진다.
		request_body {
			max_size 200MB
		}
		# 영상 분석이 분 단위까지 가므로 기본 타임아웃으로는 정상 처리 중인 요청이 끊긴다.
		reverse_proxy lie-detection:5000 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# n8n 편집 화면·웹훅 (ADR-0030·ADR-0031). handle_path 로 앞의 /n8n 을 벗겨서 n8n 에 넘긴다 —
	# 반면 compose 의 N8N_PATH=/n8n/ 는 유지: n8n 이 자산 URL·에디터 URL 을 만들 때 앞에 /n8n/ 을
	# 붙이도록. 브라우저 → /n8n/assets/xxx.js → Caddy 가 /assets/xxx.js 로 n8n 에 전달 → n8n 서빙.
	# ⚠️ handle 만 쓰면 (2026-09-08 실측): n8n 이 /n8n/assets/... 요청을 404 처리 → 편집기 하얗게 뜸.
	# Basic Auth 는 팀 전원 공유 계정 하나(ADR-0030 결정 4) — 사용자·해시는 compose 가 .env 에서
	# 환경변수로 넣는다(여기 평문 없음). 해시 만들기·저장 절차는 07-deploy "n8n" 절 참고.
	handle_path /n8n/* {
		basic_auth {
			{env.N8N_BASIC_AUTH_USER} {env.N8N_BASIC_AUTH_HASH}
		}
		reverse_proxy n8n:5678
	}

	# 배포 중 api 컨테이너가 recreate 되는 15~30초 창을 재시도로 흡수한다 —
	# 없으면 그 창 동안 502 가 뜬다. Step 2 (절반 무중단 배포) 가 실패해도
	# 여기서 잡히므로 안전망 역할을 겸한다.
	# fail_duration 0s: 단일 replica 라 한 번 실패했다고 upstream 을 죽었다고
	# 마킹하면 다음 요청도 무조건 502 로 간다. 마킹하지 않는다.
	reverse_proxy api:8000 {
		lb_try_duration 30s
		lb_try_interval 250ms
		fail_duration 0s
	}
}
