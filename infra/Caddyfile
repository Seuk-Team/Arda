# ── 거짓말 탐지(/ai/*) 를 어디로 넘기나 — infra/compute.sh 가 고른다 (2026-10-14) ──
# 아래 사이트 블록이 `import lie_{$LIE_PROXY:local}` 로 둘 중 하나를 붙인다. LIE_PROXY 는
# compose 가 caddy 컨테이너에 넣는 환경변수이고, 값은 서버 ~/arda/.compute (git 밖) 에서 온다.
# 기록이 없으면 local — **지금까지와 한 글자도 다르지 않은 설정**이다.
# 손으로 바꾸지 않는다: `bash infra/compute.sh gpu <호스트>` / `bash infra/compute.sh cpu`.

# CPU — 이 서버의 lie-detection 컨테이너 (기본·되돌리기)
(lie_local) {
	# 영상 분석이 분 단위까지 가므로 기본 타임아웃으로는 정상 처리 중인 요청이 끊긴다.
	reverse_proxy lie-detection:5000 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}

# GPU — 다른 기계(g4dn 등)의 lie-detection. **이 서버의 CPU 컨테이너를 뒤에 남겨 둔다.**
# lb_policy first: 첫째(GPU)가 살아 있으면 늘 그쪽, 헬스가 2번(≈10초) 연속 실패하면 CPU 로.
# GPU 인스턴스를 `compute.sh cpu` 없이 꺼 버려도 면접이 끊기지 않게 하는 안전판이다 —
# 그래도 끄기 전에 cpu 로 돌리는 것이 규칙이다(전환 순간 진행 중인 소켓은 끊긴다).
# 수동(passive) 헬스는 켜지 않는다: 한 번의 오류로 GPU 를 내리면 같은 면접의 지원자·담당자
# 소켓이 서로 다른 서버에 앉을 수 있다(세션 방이 프로세스 안에 있다).
(lie_remote) {
	reverse_proxy {$LIE_GPU_UPSTREAM:lie-detection:5000} lie-detection:5000 {
		lb_policy first
		lb_try_duration 10s
		lb_try_interval 250ms
		health_uri /health
		health_interval 5s
		health_timeout 3s
		health_fails 2
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}

api.seuk.suvisdev.cloud {
	handle_path /demo/* {
		root * /srv/demo
		file_server
	}

	# 거짓말 탐지 (ai/lie-detection). handle_path 라 앞의 /ai 는 떼고 넘어간다 —
	# /ai/analyze 로 들어오면 서비스는 /analyze 로 받는다.
	handle_path /ai/* {
		# 본문 한도를 여기 안에서만 올린다. 사이트 전체에 걸면 이력서 업로드(F1)의
		# 방어까지 같이 느슨해진다.
		request_body {
			max_size 200MB
		}
		# CPU(local) 또는 GPU(remote) — 맨 위 스니펫. 값이 엉뚱하면 caddy 가 못 뜨므로
		# compute.sh 가 `caddy validate` 를 먼저 돌린 뒤에만 바꾼다.
		import lie_{$LIE_PROXY:local}
	}

	# n8n 편집 화면·웹훅 (ADR-0030·ADR-0031). handle_path 로 앞의 /n8n 을 벗겨서 n8n 에 넘긴다 —
	# 반면 compose 의 N8N_PATH=/n8n/ 는 유지: n8n 이 자산 URL·에디터 URL 을 만들 때 앞에 /n8n/ 을
	# 붙이도록. 브라우저 → /n8n/assets/xxx.js → Caddy 가 /assets/xxx.js 로 n8n 에 전달 → n8n 서빙.
	# ⚠️ handle 만 쓰면 (2026-09-08 실측): n8n 이 /n8n/assets/... 요청을 404 처리 → 편집기 하얗게 뜸.
	# Basic Auth 는 팀 전원 공유 계정 하나(ADR-0030 결정 4) — 사용자·해시는 compose 가 .env 에서
	# 환경변수로 넣는다(여기 평문 없음). 해시 만들기·저장 절차는 07-deploy "n8n" 절 참고.
	handle_path /n8n/* {
		basic_auth {
			{env.N8N_BASIC_AUTH_USER} {env.N8N_BASIC_AUTH_HASH}
		}
		reverse_proxy n8n:5678
	}

	# 배포 중 api 컨테이너가 recreate 되는 15~30초 창을 재시도로 흡수한다 —
	# 없으면 그 창 동안 502 가 뜬다. Step 2 (절반 무중단 배포) 가 실패해도
	# 여기서 잡히므로 안전망 역할을 겸한다.
	# fail_duration 0s: 단일 replica 라 한 번 실패했다고 upstream 을 죽었다고
	# 마킹하면 다음 요청도 무조건 502 로 간다. 마킹하지 않는다.
	reverse_proxy api:8000 {
		lb_try_duration 30s
		lb_try_interval 250ms
		fail_duration 0s
	}
}
