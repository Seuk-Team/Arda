# 서버 ~/arda/.env — compose(docker-compose.prod.yml) 가 읽는 값. 키 이름만 적는다, 값은 서버에만.
# (api·worker 의 앱 설정은 별도 파일 ~/arda/backend/.env — 예시는 backend/.env.example)

DB_PASSWORD=

# n8n (ADR-0030, 2026-09-07)
# 자격 증명 암호화 키. 한 번 정하면 바꾸지 않는다 — 바꾸면 저장된 자격 증명을 전부 못 푼다.
# 만들기: openssl rand -hex 32. 서버 밖(팀 비밀번호 저장소)에도 한 벌 둘 것 — n8n_data 백업은 이 키 없이는 쓸모없다.
N8N_ENCRYPTION_KEY=
# 편집 화면 Basic Auth — 팀 전원 공유. 해시는 caddy 가 만든다:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<비밀번호>'
# 해시에 $ 가 들어가므로 반드시 작은따옴표로 감싼다 — 안 그러면 compose 가 $2a 를 변수로 읽는다.
N8N_BASIC_AUTH_USER=arda
N8N_BASIC_AUTH_HASH=''
# 워크플로가 우리 내부 API(/internal/email-logs/*)를 부를 때 붙이는 서비스 토큰 — 백엔드가 정하면 채운다
ARDA_SERVICE_TOKEN=
