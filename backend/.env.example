# 실제 값은 .env 에 넣는다 (.env 는 git 에 올리지 않는다)
# production 이면 기본 시크릿·공개 가입이 꺼진다. EC2 에서는 반드시 production.
# **정확히 dev 일 때만 개발 동작이다 — 미설정·오타는 production 으로 잠긴다 (#122).**
# 로컬에서 이 줄을 빼면 JWT_SECRET 미설정과 겹쳐 서버가 아예 안 뜬다.
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/arda
# 앱이 쓰는 DB 롤 이름 (DATABASE_URL 의 사용자와 같아야 한다). 이 값이 있어야
# alembic 0007 이 무결성 원장 권한을 SELECT·INSERT 로 좁힌다 — 비우면 아무것도
# 하지 않는다. 관리 롤(postgres)과 앱 롤을 가르지 않았다면 비워 둔다.
# 절차: docs/03_decision/0028-제출물-무결성-앵커.md "권한 분리 절차"
ARDA_APP_DB_ROLE=
JWT_SECRET=

# ── 제출물 무결성: 공개 체인에 못 박기 (ADR-0028 2단계) ─────────────────
# 셋 다(또는 앞의 둘) 비우면 이 기능은 그냥 꺼진다 — 접수·앵커는 그대로 돈다.
# 폴리곤 테스트넷(Amoy) 공개 RPC: https://rpc-amoy.polygon.technology
CHAIN_RPC_URL=
# ⚠️ **테스트넷 전용 지갑의 개인키만 넣는다.** 이 키로 서명한 거래만 나간다.
# 메인넷 지갑 키를 여기 넣지 않는다 — 서버가 털리면 그대로 자산이 털린다.
CHAIN_PRIVATE_KEY=
# 기록용 이름. 기본 polygon-amoy (테스트넷). 메인넷은 polygon-mainnet
CHAIN_NETWORK=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# 로컬 MinIO 쓸 때만 (예: http://localhost:9000). 비우면 실제 AWS.
# docker compose 로 돌리면 compose 가 이미 넣어 주므로 손댈 일 없다
S3_ENDPOINT_URL=
SES_FROM_EMAIL=

# 메일 큐·워커 (G2)
SQS_QUEUE_URL=
# 메일 문구의 {{회사명}}. 스키마에 회사 테이블이 없어 환경변수로 둔다
COMPANY_NAME=
# 1 이면 SES 를 부르지 않고 로그로만 찍는다 (로컬 검증용)
MAIL_DRY_RUN=
# 지원자 회신을 받을 팀 공용 주소 (G4). 사람이 보낸 메일은 그 사람 주소가,
# 에이전트·시스템 발송은 이 주소가 Reply-To 로 붙는다.
# **비우면 지원자 회신이 증발한다** — 발신은 no-reply 인데 문구는 전부
# "이 메일에 회신해 주시기 바랍니다"라고 말한다. 실제 수신 가능한 주소를 넣는다.
MAIL_REPLY_TO=

# 공개 지원 링크가 열리는 곳 (B6). 비어 있으면 상대 경로로 준다
PUBLIC_APP_BASE_URL=

# AI 에이전트 (Claude)
ANTHROPIC_API_KEY=
AGENT_CHAT_MODEL=claude-haiku-4-5-20251001
AGENT_SUMMARY_MODEL=claude-haiku-4-5-20251001

# LLM 백엔드를 역할별로 가른다 (anthropic | ollama). 전역 스위치가 아니다 —
# "요약만 로컬" 같은 중간 상태를 만들 수 있어야 한다. 비우면 anthropic.
AGENT_CHAT_BACKEND=
AGENT_SUMMARY_BACKEND=

# 아르 채팅 의도 라우터 — 뻔한 요청(지원자 목록·이름 검색·단계 변경)을 LLM 에이전트
# 루프 앞에서 잡아 코드로 실행한다. rules(기본)=regex, llm=소형 LLM 분류(판단만 LLM,
# 실행은 코드 — 표현 변형에 강함, 요청당 분류 호출 1회 추가), 0=끔.
# 로컬 sLLM 에서는 llm 권장 (2026-09-02 실측: 변형 30건 30/30). 클라우드 백엔드에서
# llm 으로 두면 분류 호출도 과금되므로 팀 결정 후 바꾼다.
AGENT_INTENT_ROUTER=

# 로컬 Ollama (AGENT_*_BACKEND=ollama 일 때만 쓰인다)
OLLAMA_HOST=
OLLAMA_CHAT_MODEL=
OLLAMA_SUMMARY_MODEL=
# 기본값이 작아서 긴 프롬프트가 조용히 잘린다. 고정부만 약 17KB다. 비우면 16384
OLLAMA_NUM_CTX=
OLLAMA_TIMEOUT_SEC=

# STT (Whisper)
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# STT 백엔드. 미설정이면 openai (지금까지와 동일, 오디오가 외부로 나간다)
#   faster_whisper 로 두면 로컬 전사 — 외부 호출 0, 비용 0. `uv sync --extra local` 필요
STT_BACKEND=
WHISPER_LOCAL_MODEL=
WHISPER_DEVICE=
WHISPER_COMPUTE_TYPE=

# 브라우저가 API 를 직접 부를 때 허용할 출처 (쉼표 구분)
CORS_ORIGINS=
