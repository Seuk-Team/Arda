# 실제 값은 .env 에 넣는다 (.env 는 git 에 올리지 않는다)
# production 이면 기본 시크릿·공개 가입이 꺼진다. EC2 에서는 반드시 production.
# **정확히 dev 일 때만 개발 동작이다 — 미설정·오타는 production 으로 잠긴다 (#122).**
# 로컬에서 이 줄을 빼면 JWT_SECRET 미설정과 겹쳐 서버가 아예 안 뜬다.
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/arda
JWT_SECRET=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# 로컬 MinIO 쓸 때만 (예: http://localhost:9000). 비우면 실제 AWS.
# docker compose 로 돌리면 compose 가 이미 넣어 주므로 손댈 일 없다
S3_ENDPOINT_URL=
SES_FROM_EMAIL=

# 메일 큐·워커 (G2)
SQS_QUEUE_URL=
# 메일 문구의 {{회사명}}. 스키마에 회사 테이블이 없어 환경변수로 둔다
COMPANY_NAME=
# 1 이면 SES 를 부르지 않고 로그로만 찍는다 (로컬 검증용)
MAIL_DRY_RUN=
# 지원자 회신을 받을 팀 공용 주소 (G4). 사람이 보낸 메일은 그 사람 주소가,
# 에이전트·시스템 발송은 이 주소가 Reply-To 로 붙는다.
# **비우면 지원자 회신이 증발한다** — 발신은 no-reply 인데 문구는 전부
# "이 메일에 회신해 주시기 바랍니다"라고 말한다. 실제 수신 가능한 주소를 넣는다.
MAIL_REPLY_TO=

# 공개 지원 링크가 열리는 곳 (B6). 비어 있으면 상대 경로로 준다
PUBLIC_APP_BASE_URL=

# AI 에이전트 (Claude)
ANTHROPIC_API_KEY=
AGENT_CHAT_MODEL=claude-haiku-4-5-20251001
AGENT_SUMMARY_MODEL=claude-haiku-4-5-20251001

# STT (Whisper)
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# STT 백엔드. 미설정이면 openai (지금까지와 동일, 오디오가 외부로 나간다)
#   faster_whisper 로 두면 로컬 전사 — 외부 호출 0, 비용 0. `uv sync --extra local` 필요
STT_BACKEND=
WHISPER_LOCAL_MODEL=
WHISPER_DEVICE=
WHISPER_COMPUTE_TYPE=

# 브라우저가 API 를 직접 부를 때 허용할 출처 (쉼표 구분)
CORS_ORIGINS=
