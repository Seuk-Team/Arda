# 실제 값은 .env 에 넣는다 (.env 는 git 에 올리지 않는다)
# production 이면 기본 시크릿·공개 가입이 꺼진다. EC2 에서는 반드시 production.
# **정확히 dev 일 때만 개발 동작이다 — 미설정·오타는 production 으로 잠긴다 (#122).**
# 로컬에서 이 줄을 빼면 JWT_SECRET 미설정과 겹쳐 서버가 아예 안 뜬다.
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/arda
JWT_SECRET=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# 로컬 MinIO 쓸 때만 (예: http://localhost:9000). 비우면 실제 AWS.
# docker compose 로 돌리면 compose 가 이미 넣어 주므로 손댈 일 없다
S3_ENDPOINT_URL=
SES_FROM_EMAIL=

# 메일 큐·워커 (G2)
SQS_QUEUE_URL=
# 메일 문구의 {{회사명}}. 스키마에 회사 테이블이 없어 환경변수로 둔다
COMPANY_NAME=
# 1 이면 SES 를 부르지 않고 로그로만 찍는다 (로컬 검증용)
MAIL_DRY_RUN=

# 공개 지원 링크가 열리는 곳 (B6). 비어 있으면 상대 경로로 준다
PUBLIC_APP_BASE_URL=

# AI 에이전트 (Claude)
ANTHROPIC_API_KEY=
AGENT_CHAT_MODEL=claude-haiku-4-5-20251001
AGENT_SUMMARY_MODEL=claude-haiku-4-5-20251001

# LLM 백엔드를 역할별로 가른다 (anthropic | ollama). 전역 스위치가 아니다 —
# "요약만 로컬" 같은 중간 상태를 만들 수 있어야 한다. 비우면 anthropic.
AGENT_CHAT_BACKEND=
AGENT_SUMMARY_BACKEND=

# 로컬 Ollama (AGENT_*_BACKEND=ollama 일 때만 쓰인다)
OLLAMA_HOST=
OLLAMA_CHAT_MODEL=
OLLAMA_SUMMARY_MODEL=
# 기본값이 작아서 긴 프롬프트가 조용히 잘린다. 고정부만 약 17KB다. 비우면 16384
OLLAMA_NUM_CTX=
OLLAMA_TIMEOUT_SEC=

# STT (Whisper)
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
