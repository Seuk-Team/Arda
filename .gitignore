# Claude Code 로컬 세션
.claude/

# 의존성·가상환경
node_modules/
.venv/

# 빌드 산출물
dist/
build/
out/
.next/
__pycache__/
*.pyc

# 환경변수·시크릿
.env
.env.*
!.env.example
# 배포 빌드용 공개 설정 — API 주소 하나뿐이고 시크릿이 없다.
# 값이 코드와 함께 버전 관리돼야 어느 커밋이 어느 API 를 보는지 추적된다.
!frontend/app/.env.production

# 에디터·OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# 로컬 전체 스택 (infra/local) — 서버에서 가져온 시크릿·데이터. 절대 커밋하지 않는다
infra/local/.env
infra/local/.env.backend
infra/local/*.sql.gz
infra/local/*.tar.gz

# 로컬 전체 스택(infra/local) 용 프론트 모드 — 시크릿 없음, 커밋한다
!frontend/app/.env.localstack
